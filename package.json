{
  "name": "keytra-action",
  "version": "1.0.0",
  "description": "GitHub Action to sync i18n files with a self-hosted Keytra instance.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keytra-app/keytra-action.git"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "esbuild": "0.28.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
